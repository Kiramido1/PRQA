{
  "openapi": "3.0.3",
  "info": { "title": "Sample Orders API (SYNTHETIC)", "version": "1.4.0-synthetic" },
  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/OrderStatus" } }
        ],
        "responses": { "200": { "description": "Order list" }, "400": { "description": "Invalid query" }, "401": { "description": "Unauthenticated" } },
        "security": [ { "bearerAuth": [] } ]
      }
    },
    "/v1/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [ { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "Order" }, "404": { "description": "Not found" } },
        "security": [ { "bearerAuth": [] } ]
      }
    },
    "/v1/orders/{orderId}/cancel": {
      "post": {
        "operationId": "cancelOrder",
        "parameters": [ { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelOrderRequest" } } } },
        "responses": { "200": { "description": "Cancelled order" }, "404": { "description": "Not found" }, "409": { "description": "Order already cancelled" }, "422": { "description": "Validation error" } },
        "security": [ { "bearerAuth": [] } ]
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "OrderStatus": { "type": "string", "enum": ["pending", "paid", "shipped", "cancelled"] },
      "CancelOrderRequest": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 500 } } },
      "Order": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "$ref": "#/components/schemas/OrderStatus" }, "cancellation_reason": { "type": ["string", "null"] } } }
    }
  }
}
