        1120,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Combine the three GitHub responses into one object for the worker's sanitizer.\nconst base = $('Resolve GitHub API Endpoint').first().json;\nconst pr = $('Fetch PR Metadata').first().json;\nconst files = $('Fetch Changed Files').all().map(i => i.json);\nconst diffItem = $('Fetch Unified Diff').first().json;\nconst diff = typeof diffItem.data === 'string' ? diffItem.data : JSON.stringify(diffItem);\nreturn [{ json: {\n  repository: base.job_seed.repository,\n  synthetic: Boolean(base.job_seed.synthetic),\n  pr,\n  files: Array.isArray(files) && files.length === 1 && Array.isArray(files[0]) ? files[0] : files,\n  diff,\n  github_api_mode: base.github_api_mode,\n  mock_response: String(pr._mock || false) === 'true',\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "1d429b9f-66f1-539d-a96a-e18342692a32",
      "name": "Assemble Raw PR Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PRQA_WORKER_URL }}/context/build",
        "authentication": "none",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Token",
              "value": "={{ $env.PRQA_WORKER_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "80084d60-8ca6-504f-b54c-ee3c6a3ed34c",
      "name": "Sanitize & Build Context Package (worker)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        300
      ],
      "notes": "redaction, truncation, changed OpenAPI operations, context_sha256",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const input = $('Context Input').first().json;\nconst built = $input.first().json;\nreturn [{ json: { ...input, context: built.context, context_source: $('Assemble Raw PR Data').first().json.github_api_mode } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "7e78ffef-98cd-50d7-b962-ae59b98f9385",
      "name": "Attach Context to Pipeline Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
