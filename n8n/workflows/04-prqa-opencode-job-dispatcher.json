{
  "id": "PrqaOpencodeDisp",
  "name": "PRQA 04 · OpenCode Job Dispatcher",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## PRQA 04 · OpenCode Job Dispatcher\n`POST /jobs` on the worker: schema validation → **policy gate** (review-only, registry, approval, fork, label) → **dedupe** (delivery id + `repo#pr@sha:level`) → queued. The worker executes: synthetic → mock executor (fixture result); real → isolated OpenCode sandbox (live mode only; `opencode_runner.py`). n8n polls every 10 s, retries a failed job once, and stops with a visible error when the worker rejects the job.",
        "height": 200,
        "width": 940,
        "color": 1
      },
      "id": "7067e897-80b3-5490-b034-08ca2d9289a5",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -60
      ]
    },
