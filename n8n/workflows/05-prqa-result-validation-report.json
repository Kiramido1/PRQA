    {
      "parameters": {
        "jsCode": "// The worker/OpenCode returned something that fails the qa-result schema: report it honestly as INCONCLUSIVE.\nconst input = $('Result Input').first().json;\nconst check = $input.first().json;\nconst r = input.result || {};\nconst pr = input.job_seed.pr;\nreturn [{ json: { result: {\n  result_version: '1.0', synthetic: Boolean(input.job_seed.synthetic), job_id: (input.job && input.job.id) || 'unknown-job',\n  repository: input.job_seed.repository,\n  pr: { number: pr.number, title: pr.title, head_sha: pr.head_sha },\n  environment: { name: input.job_seed.synthetic ? 'mock' : 'staging', base_url_redacted: 'unknown' },\n  executed_by: { engine: input.job_seed.synthetic ? 'mock_executor' : 'opencode', mode: input.job_seed.synthetic ? 'mock' : 'live' },\n  summary: { overall_status: 'INCONCLUSIVE', total: 0, passed: 0, failed: 0, blocked: 0, not_applicable: 0,\n    executive_summary: 'Result rejected by schema/reconciliation validation (INVALID_RESULT).' },\n  coverage_matrix: [], test_cases: [], defects: [],\n  blockers: ['INVALID_RESULT: ' + (check.errors || []).slice(0, 10).join(' | ')].map(s => s.slice(0, 500)),\n  recommendation: { verdict: 'INCONCLUSIVE', rationale: 'The worker returned a result that does not satisfy qa-result.schema.json.' },\n}, result_validation: check } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "a78eb1f4-0c98-5c6d-82aa-63bb58bf419a",
      "name": "Build INVALID_RESULT Placeholder (INCONCLUSIVE)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Result Input').first().json;\nconst cur = $input.first().json;\nconst result = cur.result || input.result;\nconst validation = cur.result_validation || cur;\nreturn [{ json: { result, result_validation: { valid: Boolean(validation.valid), errors: validation.errors || [] } } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "245a827c-572e-5a60-a50d-06814695041d",
      "name": "Select Result for Rendering",
      "type": "n8n-nodes-base.code",
