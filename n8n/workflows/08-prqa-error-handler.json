  "nodes": [
    {
      "parameters": {
        "content": "## PRQA 08 · Error Handler\nSet as the *Error workflow* of every PRQA workflow. Records a sanitized event on the worker and sends an alert: real Discord only when the worker reports `discord_mode == 'real'`, otherwise the mock sink. Raw error messages, URLs and tokens never leave *Sanitize Error*.",
        "height": 150,
        "width": 860,
        "color": 1
      },
      "id": "c3b180f0-b128-5f48-962f-69672709784b",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -20
      ]
    },
    {
      "parameters": {},
      "id": "064d8b60-9b77-545c-b3a3-664dba47f186",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Error Trigger payload → compact, redacted record (no stack traces, URLs or tokens leave this node).\nconst e = $input.first().json;\nconst redact = (s) => String(s || '').slice(0, 400).replace(/https?:\\/\\/\\S+/g, '[url]')\n  .replace(/gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\\w+|xai-[A-Za-z0-9]{20,}|eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+/g, '[token]');\nconst exec = e.execution || {};\nconst err = (exec.error || e.error || {});\nreturn [{ json: {\n  kind: 'pipeline_error',\n  detail: {\n    workflow_name: (e.workflow || {}).name || null,\n    workflow_id: (e.workflow || {}).id || null,\n    execution_id: exec.id || null,\n    last_node: exec.lastNodeExecuted || null,\n    error_message: redact(err.message),\n    error_node: (err.node && err.node.name) || null,\n    mode: exec.mode || null,\n    retry_of: exec.retryOf || null,\n  },\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "2c19f99f-b57b-5c9c-b327-b8aa22f9fd91",
      "name": "Sanitize Error (no raw messages / URLs / tokens)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
