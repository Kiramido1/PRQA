      "id": "74003a46-be1e-5b1a-96fb-556d3a77d16d",
      "name": "Call Prompt LLM via Model Proxy (budgeted chat/completions)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "notes": "mock endpoint in review-only; in live mode the model proxy (never the provider): prompt credential, shared provider budget (a 429 = budget refusal), locked contract, no tools. Single attempt (no retry): a timeout or error uses the reference fallback.",
      "notesInFlow": true,
      "retryOnFail": false,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pull the assistant text out of the OpenAI-compatible chat-completion response. Treated as UNTRUSTED until validated.\nconst r = $input.first().json;\nconst content = r && r.choices && r.choices[0] && r.choices[0].message ? r.choices[0].message.content : null;\n// An HTTP 200 body can carry a provider `error` object instead of content: record that it happened, never its text.\nconst providerError = r && (r.error || (r.choices && r.choices[0] && r.choices[0].error));\n// Without choices and without an error object nothing is invented: only the body's shape is reported\n// (non-JSON text arrives as `data` because the node auto-detects the response format).\nconst hasChoices = Boolean(r && Array.isArray(r.choices) && r.choices.length);\nconst shape = (hasChoices || providerError) ? null : ((r && typeof r.data === 'string') ? 'non_json_body' : 'no_choices');\nreturn [{ json: {\n  generated_text: typeof content === 'string' ? content : null,\n  llm_model: r.model || null,\n  llm_finish_reason: (r.choices && r.choices[0] && r.choices[0].finish_reason) || null,\n  llm_usage: r.usage || null,\n  llm_error: (providerError && typeof content !== 'string') ? 'provider error in HTTP 200 body' : null,\n  llm_response_shape: shape,\n}}];",
        "mode": "runOnceForAllItems"
      },
      "id": "be728eac-a903-5be4-b10e-866d7ea0c8ab",
      "name": "Extract Generated Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
