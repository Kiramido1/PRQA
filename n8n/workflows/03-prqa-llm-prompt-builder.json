              "name": "X-PRQA-Job-Id",
              "value": "={{ (String($('Prompt Builder Input').first().json.job_seed.repository || 'pr').replace(/[^A-Za-z0-9_.-]/g, '-') + '-' + String($('Prompt Builder Input').first().json.job_seed.pr.number)).slice(0, 100) }}"
            },
