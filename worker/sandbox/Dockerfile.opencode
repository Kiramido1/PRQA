# OpenCode sandbox image — PHASE 2 ONLY. Not built or used while AUTOMATION_MODE=review_only.
#
# What runs inside: git (shallow clone at the pinned PR head SHA), curl, jq, unzip, file,
# Python stdlib for local inspection, and the OpenCode CLI. Nothing else.
# Network: the worker attaches the container to a dedicated sandbox network that can
# reach only the approved test target (and github.com for the clone). No Docker socket,
# no host mounts, read-only root filesystem, tmpfs work dirs, non-root user.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl jq unzip file ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g opencode-ai@1.19.3 \
    && groupadd -g 10001 sandbox && useradd -u 10001 -g 10001 -M -d /home/sandbox -s /bin/bash sandbox

COPY entrypoint.sh /usr/local/bin/prqa-sandbox-entrypoint
COPY verify_checkout.py /usr/local/bin/prqa-verify-checkout
COPY populate_checkout.py /usr/local/bin/prqa-populate-checkout
COPY chunked_run.py /usr/local/bin/prqa-chunked-run
COPY record.py /usr/local/bin/prqa-record
# /checkout is the mount point of the per-job named volume: the helper container (same image, --entrypoint
# prqa-populate-checkout, uid 10001) extracts the artifact into it; the sandbox mounts it READ-ONLY. The directory is
# owned by 10001 so a fresh volume inherits writable ownership for the helper; the sandbox rootfs stays --read-only.
RUN chmod 0555 /usr/local/bin/prqa-sandbox-entrypoint /usr/local/bin/prqa-verify-checkout /usr/local/bin/prqa-populate-checkout /usr/local/bin/prqa-chunked-run /usr/local/bin/prqa-record \
    && mkdir -p /checkout && chown 10001:10001 /checkout && chmod 0755 /checkout

USER 10001:10001
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/prqa-sandbox-entrypoint"]
