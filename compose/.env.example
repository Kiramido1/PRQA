# PR QA Pilot — copy to compose/.env, then: chmod 600 compose/.env
# Never commit compose/.env.
#
# =====================================================================
#  PHASE 1 SAFE DEFAULTS — REVIEW ONLY. Do not change these until the
#  n8n workflows have been visually reviewed and Phase 2 is explicitly
#  approved. The worker fails closed: while AUTOMATION_MODE=review_only
#  every REAL_* flag is forced to false even if set to true here.
# =====================================================================
AUTOMATION_MODE=review_only
REAL_PROJECT_TESTING_ENABLED=false
AUTO_EXECUTION_ENABLED=false
REAL_GITHUB_REPORTING_ENABLED=false
REAL_DISCORD_REPORTING_ENABLED=false
REPOSITORY_REGISTRY_DEFAULT_ENABLED=false
# The only review-only exception: send prompt-builder LLM calls to the real provider (direct Groq).
# Affects nothing else. Set to true only for an explicitly approved prompt-delivery test.
PROMPT_LLM_LIVE_IN_REVIEW_ONLY=false

# --- n8n ---
# Pinned image tag; set by scripts/start.sh from the pulled image (e.g. 1.120.4)
N8N_IMAGE_TAG=latest
GENERIC_TIMEZONE=UTC
# Generate once: openssl rand -hex 32  (back it up; losing it breaks stored n8n credentials)
N8N_ENCRYPTION_KEY=<generate-64-hex-chars>
# Local owner account created by scripts/setup_n8n_owner.sh (change the password after first login)
N8N_OWNER_EMAIL=owner@prqa.local
N8N_OWNER_PASSWORD=<generated-by-setup-script>

# --- n8n <-> worker shared secret (header X-Worker-Token) ---
# Generate: openssl rand -hex 32
PRQA_WORKER_TOKEN=<generate-64-hex-chars>

# --- GitHub webhook HMAC secret (X-Hub-Signature-256) ---
# Phase 1: a locally generated value used only to sign SYNTHETIC fixtures.
# Phase 2: must equal the secret configured on the real GitHub webhook.
GITHUB_WEBHOOK_SECRET=<generate-64-hex-chars>

# --- PR label trigger ---
# Adding this label to an open, non-draft PR of a registered repository requests a run (qa-test:* labels still work).
# Removing it, closing the PR or pushing new commits cancels active jobs for that PR; re-label to test the new head.
PRQA_TRIGGER_LABEL=to be test
PRQA_DEFAULT_TEST_LEVEL=standard
# Isolated per-job workspaces live in the worker volume (/data/workspaces); marked directories older than this are removed.
PRQA_WORKSPACE_RETENTION_HOURS=24
PRQA_CHECKOUT_TIMEOUT_S=300
# Phase 2 only: let the worker perform the pinned, hook-free checkout and pack it into a per-job artifact for the sandbox
# (the sandbox never clones and never receives GITHUB_TOKEN).
PRQA_WORKER_CHECKOUT_ENABLED=false
PRQA_CHECKOUT_MAX_MB=500
PRQA_WORKSPACE_MIN_FREE_MB=1024
PRQA_WORKSPACE_MAX_COUNT=50
# Sandbox network for live jobs, read by BOTH the launcher and the Docker policy proxy (one variable, so they cannot
# disagree): none (default; no model access) or the internal compose network prqa_prqa_sandbox (compose project "prqa":
# internal, inhibit_ipv4, labelled prqa.net=sandbox). The model proxy requires the latter; the launcher refuses
# "none" when the model proxy is configured and verifies internal + label + inhibit_ipv4 before every launch.
PRQA_SANDBOX_NETWORK=none
# --- Phase 2 launcher / proxies (compose profile "phase2", never started by default) ---
# Separate credential for the launcher <-> worker hand-off API. Not the worker token, not the admin token.
# Leave empty here: scripts/setup/provision_model_proxy_secrets.py generates it into ~/.config/prqa/secrets.env, which
# scripts/start.sh passes after this file (32-256 chars of A-Z a-z 0-9 _ -; malformed values fail closed).
PRQA_LAUNCHER_TOKEN=
# GID the policy proxy chowns its listen socket to (created 0660 root:<GID>). It MUST equal the launcher
# container's primary GID (compose sets user "10002:10002"): only that group can open the policy socket, and a
# mismatch fails closed (the launcher cannot connect). Keep the two values in sync when changing either.
PRQA_LAUNCHER_GID=10002
# Pinned sandbox image ID (docker image inspect prqa/opencode-sandbox:local --format '{{.Id}}'); the launcher refuses anything else.
PRQA_SANDBOX_IMAGE_ID=
# Model egress proxy (direct Groq, openai/gpt-oss-120b — fixed in compose): sandboxes reach the INFERENCE listener
# PRQA_MODEL_PROXY_INFERENCE_URL=http://prqa-model-proxy:8089/v1 (per-job token, chat completions only). The ADMIN API is
# a unix socket shared with the launcher only: PRQA_MODEL_PROXY_ADMIN_URL=unix:///run/prqa-model-admin/admin.sock (a TCP
# admin URL is refused). All three model-proxy settings or none: a partial configuration is refused by the launcher.
# SECRETS DO NOT GO HERE: PRQA_MODEL_PROXY_ADMIN_TOKEN (proxy only), PRQA_MODEL_PROXY_MINT_TOKEN (launcher: issue/revoke
# its own per-job tokens only), PRQA_MODEL_PROXY_PROMPT_TOKEN (n8n prompt generation: inference only, no tools) and
# PRQA_MODEL_PROVIDER_KEY_FILE (path of the raw Groq key file, chmod 600, outside the project drive) belong in
# ~/.config/prqa/secrets.env, maintained by scripts/setup/provision_model_proxy_secrets.py (never prints a value).
PRQA_MODEL_PROXY_INFERENCE_URL=
PRQA_MODEL_PROXY_ADMIN_URL=
# Optional: only these GitHub logins may start a run by adding the label (checked on the HMAC-authenticated webhook sender).
PRQA_TRIGGER_ALLOWED_ACTORS=
# Local poller (scripts/pipeline/prqa_label_poller.py): state file (no secrets) and rerun policy.
PRQA_POLL_STATE_FILE=runs/poller-state.json
PRQA_POLL_RERUN_ON_RELABEL=true
PRQA_POLL_RETEST_ON_NEW_SHA=false

# --- GitHub Actions entry secret (X-PRQA-Signature on POST /webhook/prqa/actions) ---
# Generate: openssl rand -hex 32. The SAME value goes into the GitHub repository secret PRQA_WEBHOOK_SECRET
# (docs/GITHUB_ACTIONS_ONBOARDING.md). Only the worker reads it. Empty = every Actions request is rejected (401).
PRQA_WEBHOOK_SECRET=<generate-64-hex-chars>
# Accepted clock skew / replay window for signed Actions requests, seconds.
PRQA_WEBHOOK_TOLERANCE_S=300

# --- Real integrations: LEAVE EMPTY in Phase 1 ---
# Fine-grained PAT, read-only (Metadata, Contents, Pull requests) + "Issues: write" only if PR comments are approved.
GITHUB_TOKEN=
# Prompt-builder LLM — ACTIVE PROVIDER: direct Groq, openai/gpt-oss-120b (docs/GROQ_MIGRATION.md). There is no
# OpenRouter fallback: if Groq fails or its output fails the quality gate, the deterministic reference fallback is used.
# Key: GROQ_API_KEY only (no cross-provider fallback). NEVER put a real key in this template or in compose/.env:
# compose/.env sits on a FUSE/NTFS drive that is readable by every local user whatever chmod says. Put it in
# ~/.config/prqa/secrets.env (chmod 600, dir chmod 700). No service receives it through the environment: the
# provisioning script derives the model proxy's key file from it, and n8n sends prompt generation to the model proxy
# (shared provider budget) with PRQA_MODEL_PROXY_PROMPT_TOKEN. Real-mode target: PRQA_PROMPT_LLM_PROXY_URL (default
# http://prqa-model-proxy:8089/v1).
PROMPT_LLM_API_BASE=https://api.groq.com/openai/v1
PROMPT_LLM_MODEL=openai/gpt-oss-120b
# Leave empty here; set GROQ_API_KEY in ~/.config/prqa/secrets.env (https://console.groq.com/keys).
GROQ_API_KEY=
# Legacy key slot for the retired OpenRouter evaluator only (its network path now refuses); never used for Groq.
PROMPT_LLM_API_KEY=
# Generation settings (non-secret; the worker refuses to start on invalid values):
#   PROMPT_LLM_MAX_TOKENS            completion limit, 1..24000 (default 3000); sent to Groq as max_completion_tokens
#   PROMPT_LLM_REASONING_EFFORT      GPT-OSS reasoning_effort: low (default) | medium | high; sent with include_reasoning=false
#   PROMPT_LLM_REASONING             auto | on | off — the OpenRouter-only `reasoning` field; never sent to Groq (on is refused)
#   PROMPT_LLM_REASONING_MAX_TOKENS  legacy OpenRouter reasoning cap; refused for Groq
PROMPT_LLM_MAX_TOKENS=3000
PROMPT_LLM_REASONING_EFFORT=low
# Discord incoming webhook for a TEST channel. Read by the worker (report delivery) and n8n (error-handler alerts).
# Real delivery additionally requires AUTOMATION_MODE=live and REAL_DISCORD_REPORTING_ENABLED=true; until then the mock sink is used.
DISCORD_WEBHOOK_URL=
# OpenCode model in provider/model form: prqa/openai/gpt-oss-120b = GPT-OSS 120B on direct Groq through the PRQA model
# proxy. OpenCode never holds a provider key (it authenticates to the proxy with a per-job token).
OPENCODE_MODEL=prqa/openai/gpt-oss-120b
# Not used by the active path. Read only by the historical scripts/eval/evaluate_openrouter_live.py evaluator.
OPENROUTER_API_KEY=

# --- Provider budget (shared ledger of the model proxy and scripts/eval/evaluate_groq_live.py; hard caps, not targets) ---
# The ledger directory itself (PRQA_PROVIDER_BUDGET_DIR) is provisioned into ~/.config/prqa/secrets.env by
# scripts/setup/provision_model_proxy_secrets.py. Empty or invalid values fail closed (no provider request is sent).
# Groq on-demand limit for openai/gpt-oss-120b treated as 8000 tokens/minute (no larger limit assumed).
# Daily caps: every value must be a positive integer (0 or empty fails closed), so there is no "unlimited" setting.
# 1000000000 is the operator-chosen value (2026-10-27): it is still a cap, but it effectively DISABLES daily
# protection: daily spend is then bounded only by the per-minute, per-job and in-flight caps below and by the
# provider account's own limits. Every request is still reserved and counted in the shared ledger. For a
# conservative setup use e.g. PRQA_BUDGET_DAILY_REQUESTS=5 and PRQA_BUDGET_DAILY_TOKENS=40000.
PRQA_BUDGET_DAILY_REQUESTS=1000000000
PRQA_BUDGET_DAILY_TOKENS=1000000000
PRQA_BUDGET_JOB_TOKENS=24000
PRQA_BUDGET_TOKENS_PER_MINUTE=8000
PRQA_BUDGET_MAX_IN_FLIGHT=1
# Calibrated estimates (no local tokenizer): proxy request bytes per prompt token (measured 4.98 on the OpenCode
# payload, minus ~10%) and evaluator prompt characters per token (measured 4.02 on the C01 prompt, minus ~10%).
PRQA_BUDGET_PROXY_BYTES_PER_TOKEN=4.5
PRQA_BUDGET_PROMPT_CHARS_PER_TOKEN=3.6
PRQA_BUDGET_MAX_WAIT_S=90

# Where the agent runs: local = the agent CLI on this machine under bubblewrap | sandbox = worker job + launcher container
PRQA_OPENCODE_EXECUTOR=local
# Agent CLI for the local executor: claude = Claude Code (`claude -p`, Bash tool only, operator's Claude login) | opencode
PRQA_LOCAL_ENGINE=claude
# Model for that agent (empty = engine default: claude-sonnet-5-5 / opencode/glm-5.3-flash-free)
PRQA_LOCAL_MODEL=claude-sonnet-5-5
