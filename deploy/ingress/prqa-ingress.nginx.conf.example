# PRQA public ingress — EXAMPLE, not installed or enabled anywhere. Exposes exactly ONE route:
#   POST https://<YOUR-AUTHORIZED-HOSTNAME>/webhook/prqa/actions  ->  n8n PRQA 01 (127.0.0.1:5678, loopback-only)
# Everything else (n8n editor/REST API, /webhook-test, worker :8080, mocks :8090, model proxy, admin socket) is NOT proxied.
# Requires: an authorized DNS name pointing at a reachable server, a valid TLS certificate, and (separately approved)
# activation of workflow PRQA 01 — until then n8n answers 404 for this path and nothing is dispatched.
# Validate before reload:  sudo nginx -t   (then: sudo systemctl reload nginx)

limit_req_zone $binary_remote_addr zone=prqa_ingress:1m rate=30r/m;

server {
    listen 443 ssl;
    http2 on;
    server_name <YOUR-AUTHORIZED-HOSTNAME>;

    ssl_certificate     /etc/letsencrypt/live/<YOUR-AUTHORIZED-HOSTNAME>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<YOUR-AUTHORIZED-HOSTNAME>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16k;          # matches the receiver's 16 KiB connection-dispatch limit
    client_body_buffer_size 16k;
    server_tokens off;

    location = /webhook/prqa/actions {
        limit_except POST { deny all; }
        limit_req zone=prqa_ingress burst=10 nodelay;
        proxy_pass http://127.0.0.1:5678/webhook/prqa/actions;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering on;    # raw body is forwarded byte-for-byte; HMAC is verified by the worker
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / { return 404; }
}
