{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prqa.example.test/schemas/job-request/1.0/job-request.schema.json",
  "title": "PR QA Pilot — worker job request (POST /jobs)",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "pr", "test_level", "trigger", "prompt", "synthetic"],
  "properties": {
    "synthetic": {
      "type": "boolean",
      "description": "Must be true for fixture repositories (synthetic-org/*). Real jobs are rejected while review-only mode is active."
    },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$" },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "head_sha", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "title": { "type": "string", "maxLength": 300 },
        "base_ref": { "type": "string", "maxLength": 255 },
        "head_ref": { "type": "string", "maxLength": 255 },
        "is_fork": { "type": "boolean" },
        "url": { "type": "string", "maxLength": 500 }
      }
    },
    "test_level": { "enum": ["smoke", "standard", "comprehensive", "security"] },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["github_webhook", "github_actions", "local_poller", "synthetic_test", "manual"] },
        "delivery_id": { "type": "string", "maxLength": 100 },
        "label": { "type": "string", "maxLength": 100 },
        "requested_by": { "type": "string", "maxLength": 100 },
        "requested_label": { "type": "string", "maxLength": 100, "description": "The opt-in label the caller used (GitHub Actions path); `label` carries the mapped qa-test:* label" },
        "run_url": { "type": "string", "maxLength": 500, "description": "Link to the originating GitHub Actions run (GitHub Actions path)" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "sha256"],
      "properties": {
        "text": { "type": "string", "minLength": 200, "maxLength": 200000 },
        "source": { "enum": ["llm", "reference_fallback", "fixture"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "template_version": { "type": "string", "maxLength": 20 }
      }
    },
    "context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "n8n_execution_id": { "type": "string", "maxLength": 50 }
  }
}
